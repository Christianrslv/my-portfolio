---
/* ORIGINAL IMPORTS - Uncomment when ready to go live
import Analytics from '@vercel/analytics/astro'
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import HorizontalTimeline from '../components/HorizontalTimeline.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
import MobileTimeline from '../components/MobileTimeline.astro';
import { portfolioConfig } from '../data/config';
import { getPortfolioContent } from '../utils/content';
import { getPortfolioContentSimple } from '../utils/content-simple';
import { getCollection } from 'astro:content';
*/

// Temporary placeholder to prevent build errors (these won't be used due to redirect above)
import Analytics from '@vercel/analytics/astro'
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import HorizontalTimeline from '../components/HorizontalTimeline.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
import MobileTimeline from '../components/MobileTimeline.astro';
import { portfolioConfig } from '../data/config';
import { getPortfolioContent } from '../utils/content';
import { getPortfolioContentSimple } from '../utils/content-simple';
import { getCollection } from 'astro:content';

// Try multiple methods to load content
let content = null;

// Method 1: Try Content Collections
try {
	const portfolioEntries = await getCollection('portfolio');
	
	if (portfolioEntries.length > 0) {
		content = await getPortfolioContent();
	}
} catch (error) {
	console.warn('[Index] Content Collections failed:', error);
}

// Method 2: Fallback to simple glob loader
if (!content) {
	try {
		content = await getPortfolioContentSimple();
	} catch (error) {
		console.warn('[Index] Simple loader failed:', error);
	}
}

// Merge content with config fallback
const config = {
	nav: portfolioConfig.nav,
	hero: content?.hero || portfolioConfig.hero,
	about: {
		...portfolioConfig.about,
		// Only override paragraphs if content has them (not empty)
		...(content?.about?.paragraphs && content.about.paragraphs.length > 0
			? { paragraphs: content.about.paragraphs }
			: {}),
		// Always override other about properties if they exist in content
		...(content?.about?.showImage !== undefined ? { showImage: content.about.showImage } : {}),
		...(content?.about?.imageUrl ? { imageUrl: content.about.imageUrl } : {}),
		...(content?.about?.imageAlt ? { imageAlt: content.about.imageAlt } : {}),
	},
	skills: content?.skills || portfolioConfig.skills,
	projects: content?.projects || portfolioConfig.projects,
	contact: content?.contact || portfolioConfig.contact,
	footer: portfolioConfig.footer,
};

---

<Layout>
  <Analytics/>
	<Navbar logo={config.nav?.logo || portfolioConfig.nav.logo} links={config.nav?.links || portfolioConfig.nav.links} />

	<ScrollIndicator totalSections={6} />

	<div id="scroll-root" class="relative">
		<div 
			id="scroll-stage-bg"
			class="scroll-stage relative h-screen w-full overflow-hidden"
			data-background-image={config.hero.backgroundImage || ''}
		>
			<div class="base-background"></div>
			{config.hero.backgroundImage && (
				<>
					<div 
						class="background-image-layer"
						style={`background-image: url('${config.hero.backgroundImage}');`}
					></div>
					<!-- Full overlay for Section 0 -->
					<div class="overlay-full"></div>
					<!-- Gradient overlay for Section 1 (left side dark, right side transparent) -->
					<div class="overlay-gradient"></div>
				</>
			)}
			<section id="home" class="scroll-panel flex min-h-screen w-full items-center justify-center">
				<Hero
					greeting={config.hero.greeting}
					name={config.hero.name}
					role={config.hero.role}
					description={config.hero.description}
					primaryButton={config.hero.primaryButton}
					secondaryButton={config.hero.secondaryButton}
				/>
			</section>

			<section id="about" class="scroll-panel flex min-h-screen w-full items-center justify-center">
				<About
					paragraphs={config.about.paragraphs}
					stats={portfolioConfig.about.stats}
				/>
			</section>

			<section id="skills" class="scroll-panel flex min-h-screen w-full items-center justify-center h-screen">
				<Skills categories={config.skills.categories} />
			</section>

			<section id="projects" class="scroll-panel flex min-h-screen h-screen w-full items-center justify-center">
				<Projects projects={config.projects} />
			</section>

      <HorizontalTimeline class="hidden lg:flex"/>
      <MobileTimeline class="lg:hidden"/>
      
			<section id="contact" class="scroll-panel flex flex-col min-h-screen w-full items-center justify-center z-90!">
				<Contact
					description={config.contact.description}
					email={config.contact.email}
					socialLinks={config.contact.socialLinks}
				/>
				<Footer text={portfolioConfig.footer.text} year={portfolioConfig.footer.year} />
			</section>
		</div>
	</div>
</Layout>

<script>
	// @ts-nocheck
	import gsap from 'gsap';
	import ScrollTrigger from 'gsap/ScrollTrigger';
	import Swiper from 'swiper';
	import { EffectCreative, Mousewheel, HashNavigation, Pagination } from 'swiper/modules';
	import 'swiper/css';
	import 'swiper/css/effect-creative';
	import 'swiper/css/pagination';

	gsap.registerPlugin(ScrollTrigger);

	// ============================================
	// CONSTANTS & CONFIGURATION
	// ============================================
	const BREAKPOINT_MOBILE = 1024;
	const SECTION_SCROLL_UNITS = 0.80;
	const TIMELINE_SCROLL_UNITS = 0.75;
	const SECTION_TOLERANCE = 0.65;
	const BACKGROUND_IMAGE_END_SECTION = 2;
	const ZOOM_START = 1.0;
	const ZOOM_END = 1.5;
	const ZOOM_COMPLETION_POINT = 0.7;
	const EXIT_COMPLETION_POINT = 0.6;
	const EXIT_TRANSLATE_DISTANCE = -40;
	const RESIZE_DEBOUNCE_MS = 150;

	// ============================================
	// UTILITY FUNCTIONS
	// ============================================
	const isMobile = () => window.innerWidth <= BREAKPOINT_MOBILE;

	const getDatasetValue = (element, key, defaultValue) => {
		return parseFloat(element.dataset[key] || defaultValue);
	};

	const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

	const setElementVisibility = (element, opacity) => {
		if (!element) return;
		element.style.opacity = String(Math.max(0, opacity));
		element.style.visibility = opacity > 0.01 ? 'visible' : 'hidden';
	};

	// ============================================
	// TIMELINE CALCULATIONS
	// ============================================
	function calculateTimelineData(sections) {
		const timelineSection = sections.find(s => s.id === 'desktop-timeline');
		const timelineEntries = timelineSection
			? parseInt(timelineSection.dataset.timelineEntries || '1', 10)
			: 1;
		const timelineSegments = Math.max(0, timelineEntries - 1);
		const timelineUnits = timelineSegments > 0
			? timelineSegments * TIMELINE_SCROLL_UNITS
			: SECTION_SCROLL_UNITS;
		const timelineIndex = sections.findIndex(s => s.id === 'desktop-timeline');
		const extraUnits = timelineIndex >= 0 ? Math.max(0, timelineUnits - SECTION_SCROLL_UNITS) : 0;

		return { timelineSegments, timelineUnits, timelineIndex, extraUnits };
	}

	function calculateScrollHeight(sections, scrollRoot) {
		const total = sections.length;
		const { timelineSegments, timelineUnits, extraUnits } = calculateTimelineData(sections);
		const totalSegments = (total - 1) * SECTION_SCROLL_UNITS + extraUnits;
		const scrollDistance = (totalSegments + 1) * window.innerHeight;

		// Store in dataset for later retrieval
		scrollRoot.dataset.totalSegments = String(totalSegments);
		scrollRoot.dataset.timelineSegments = String(timelineSegments);
		scrollRoot.dataset.timelineUnits = String(timelineUnits);
		scrollRoot.dataset.timelineExtraUnits = String(extraUnits);
		scrollRoot.style.height = `${scrollDistance}px`;

		return scrollDistance;
	}

	// ============================================
	// SECTION MANAGEMENT
	// ============================================
	function initializeSectionPositions(sections) {
		sections.forEach((section, index) => {
			const xOffset = index % 2 === 0 ? -60 : 60;
			gsap.set(section, {
				autoAlpha: 0,
				y: 40,
				x: xOffset,
				position: 'absolute',
				top: 0,
				left: 0,
				width: '100%',
			});
		});
		gsap.set(sections[0], { autoAlpha: 1, y: 0, x: 0 });
	}

	function calculateTargetSection(exactProgress, total) {
		const rawFrac = exactProgress - Math.floor(exactProgress);
		let targetIndex = Math.floor(exactProgress);

		if (rawFrac < SECTION_TOLERANCE) {
			targetIndex = Math.floor(exactProgress);
		} else if (rawFrac > 1 - SECTION_TOLERANCE) {
			targetIndex = Math.min(total - 1, Math.floor(exactProgress) + 1);
		} else {
			targetIndex = rawFrac < 0.5
				? Math.floor(exactProgress)
				: Math.min(total - 1, Math.floor(exactProgress) + 1);
		}

		return clamp(targetIndex, 0, total - 1);
	}

	function animateSection(section, index, isActive) {
		const xOffset = index % 2 === 0 ? -60 : 60;

		gsap.to(section, {
			autoAlpha: isActive ? 1 : 0,
			y: isActive ? 0 : 40,
			x: isActive ? 0 : xOffset,
			duration: 0.3,
			ease: 'power2.out',
			overwrite: true,
		});
	}

	function updateSectionVisibility(sections, targetIndex, activeIndex) {
		if (targetIndex === activeIndex) return activeIndex;

		sections.forEach((section, i) => {
			animateSection(section, i, i === targetIndex);
		});

		window.dispatchEvent(new CustomEvent('sectionchange', {
			detail: { index: targetIndex }
		}));

		return targetIndex;
	}

	// ============================================
	// PROGRESS CALCULATIONS
	// ============================================
	function calculateProgress(exactProgress, sections, scrollRoot) {
		const timelineIndex = sections.findIndex(s => s.id === 'desktop-timeline');
		const timelineUnits = getDatasetValue(
			scrollRoot,
			'timelineUnits',
			String(TIMELINE_SCROLL_UNITS)
		);
		const timelineLength = timelineIndex >= 0 ? timelineUnits : SECTION_SCROLL_UNITS;
		const timelineExtraUnits = getDatasetValue(scrollRoot, 'timelineExtraUnits', '0');

		let mappedProgress = exactProgress / SECTION_SCROLL_UNITS;
		let timelineProgress = 0;

		if (timelineIndex >= 0) {
			const timelineStart = timelineIndex * SECTION_SCROLL_UNITS;
			const timelineEnd = timelineStart + timelineLength;
			const transitionWindow = SECTION_SCROLL_UNITS * 0.6;
			const transitionStart = timelineEnd - transitionWindow;

			if (exactProgress < timelineStart) {
				mappedProgress = exactProgress / SECTION_SCROLL_UNITS;
				timelineProgress = 0;
			} else if (exactProgress >= timelineStart && exactProgress <= timelineEnd) {
				timelineProgress = (exactProgress - timelineStart) / timelineLength;

				if (exactProgress < transitionStart) {
					mappedProgress = timelineIndex;
				} else {
					// During transition - smoothly move to next section
					const transitionProgress = (exactProgress - transitionStart) / transitionWindow;
					mappedProgress = timelineIndex + transitionProgress;
				}
			} else {
				// Past timeline end - use original calculation that accounts for extra units
				mappedProgress = (exactProgress - timelineExtraUnits) / SECTION_SCROLL_UNITS;
				timelineProgress = 1;
			}
		}

		return { mappedProgress, timelineProgress };
	}

	// ============================================
	// BACKGROUND ANIMATION
	// ============================================
	function calculateZoomProgress(currentSection, sectionProgress, isDesktop) {
		if (currentSection !== 0) return { zoomProgress: 1, zoomScale: isDesktop ? ZOOM_END : 1.0 };

		const zoomProgress = Math.min(1, sectionProgress / ZOOM_COMPLETION_POINT);
		const zoomScale = isDesktop
			? ZOOM_START + (ZOOM_END - ZOOM_START) * zoomProgress
			: 1.0;

		return { zoomProgress, zoomScale };
	}

	function calculateExitProgress(currentSection, sectionProgress) {
		if (currentSection === 1) {
			return Math.min(1, sectionProgress / EXIT_COMPLETION_POINT);
		}
		return currentSection >= 2 ? 1 : 0;
	}

	// ============================================
	// EDITORIAL EXIT TRANSITION (Isolated - easy to remove)
	// Blur + delayed opacity fade (no desaturation)
	// ============================================
	function applyEditorialExitEffect(element, exitProgress) {
		// Blur: 0 → 16px (full range of exit)
		const blurAmount = exitProgress * 16;

		// Opacity: only fades in last 40% of exit (delayed fade)
		const opacityStart = 0.6;
		const opacity = exitProgress < opacityStart
			? 1
			: 1 - ((exitProgress - opacityStart) / (1 - opacityStart));

		element.style.filter = `blur(${blurAmount}px)`;
		element.style.opacity = String(Math.max(0, opacity));
		element.style.visibility = opacity > 0.01 ? 'visible' : 'hidden';
	}

	function resetEditorialExitEffect(element) {
		element.style.filter = 'none';
	}

	// ============================================
	// OPTION D: "Forward Voyage Through the Horizon"
	// Continuous scroll-driven camera illusion on background image
	// ============================================
	function applyForwardVoyageEffect(element, currentSection, sectionProgress, zoomScale) {
		// Only active during Hero (0) and About (1) sections
		if (currentSection >= BACKGROUND_IMAGE_END_SECTION) return null;

		// Calculate total voyage progress (0 at start of Hero, 1 at end of About)
		const totalVoyageProgress = currentSection === 0
			? sectionProgress * 0.6  // Hero contributes 60% of voyage
			: 0.6 + (sectionProgress * 0.4);  // About contributes remaining 40%

		// --- LATERAL DRIFT ---
		// Drift rightward as we "sail" through the scene
		const maxDrift = 8; // vw
		const lateralDrift = totalVoyageProgress * maxDrift;

		// --- FORWARD MOTION (enhanced scale) ---
		// Add subtle extra scale on top of existing zoom for "moving forward" feel
		const forwardBoost = 1 + (totalVoyageProgress * 0.15); // up to 15% extra
		const combinedScale = zoomScale * forwardBoost;

		// --- PARALLAX via background-position ---
		// Shift background position to create "horizon stable, foreground moves" illusion
		// As we progress, reveal more of the right side of the image
		const bgPositionX = 100 - (totalVoyageProgress * 15); // 100% → 85%
		element.style.backgroundPosition = `${bgPositionX}% bottom`;

		// --- WIND DOWN during About section ---
		// Gradually reduce effect intensity as exit approaches
		let windDownMultiplier = 1;
		if (currentSection === 1) {
			// Ease out the voyage as we approach exit
			windDownMultiplier = 1 - (sectionProgress * 0.7);
		}

		// Apply combined transform with small delay after scroll stops
		const finalDrift = lateralDrift * windDownMultiplier;
		element.style.transform = `translateX(${finalDrift}vw) scale(${combinedScale})`;
		element.style.transition = 'transform 0.2s linear';

		return { totalVoyageProgress, windDownMultiplier };
	}

	function updateBackgroundImage(backgroundImageLayer, currentSection, sectionProgress, isDesktop) {
		backgroundImageLayer.style.backgroundPosition = 'right bottom';

		const { zoomProgress, zoomScale } = calculateZoomProgress(currentSection, sectionProgress, isDesktop);
		const exitProgress = calculateExitProgress(currentSection, sectionProgress);

		// Forward Voyage effect: continuous camera motion during Hero + About
		if (currentSection < BACKGROUND_IMAGE_END_SECTION) {
			applyForwardVoyageEffect(backgroundImageLayer, currentSection, sectionProgress, zoomScale);
		} else {
			// Section 2+: reset to default scale
			backgroundImageLayer.style.transform = `scale(${zoomScale})`;
		}

		return { zoomProgress, exitProgress };
	}

	function updateOverlays(overlayFull, overlayGradient, currentSection, zoomProgress, exitProgress) {
		const overlayTransitionProgress = currentSection === 0 ? zoomProgress : 1;

		if (currentSection >= BACKGROUND_IMAGE_END_SECTION) {
			// Section 2+: Hide everything
			setElementVisibility(overlayFull, 0);
			setElementVisibility(overlayGradient, 0);
		} else if (currentSection === 1) {
			// Section 1: Gradient visible, fades with exit
			setElementVisibility(overlayFull, 0);
			setElementVisibility(overlayGradient, 1 - exitProgress);
		} else {
			// Section 0: Transition from full to gradient
			setElementVisibility(overlayFull, 1 - overlayTransitionProgress);
			setElementVisibility(overlayGradient, overlayTransitionProgress);
		}
	}

	function updateBackgroundLayers(clampedMappedProgress) {
		const backgroundStage = document.getElementById('scroll-stage-bg');
		if (!backgroundStage?.dataset.backgroundImage) return;

		const backgroundImageLayer = backgroundStage.querySelector('.background-image-layer');
		const overlayFull = backgroundStage.querySelector('.overlay-full');
		const overlayGradient = backgroundStage.querySelector('.overlay-gradient');

		if (!backgroundImageLayer) return;

		const currentSection = Math.floor(clampedMappedProgress);
		const sectionProgress = clampedMappedProgress - currentSection;
		const isDesktop = window.innerWidth >= BREAKPOINT_MOBILE;

		const { zoomProgress, exitProgress } = updateBackgroundImage(
			backgroundImageLayer,
			currentSection,
			sectionProgress,
			isDesktop
		);

		// Handle image visibility
		if (currentSection >= BACKGROUND_IMAGE_END_SECTION) {
			setElementVisibility(backgroundImageLayer, 0);
			resetEditorialExitEffect(backgroundImageLayer);
		} else if (currentSection === 1) {
			// Editorial exit: blur + desaturation + delayed fade
			applyEditorialExitEffect(backgroundImageLayer, exitProgress);
		} else {
			backgroundImageLayer.style.opacity = '1';
			backgroundImageLayer.style.visibility = 'visible';
			resetEditorialExitEffect(backgroundImageLayer);
		}

		updateOverlays(overlayFull, overlayGradient, currentSection, zoomProgress, exitProgress);
	}


	// ============================================
	// NAVIGATION
	// ============================================
	function scrollToSection(sections, scrollRoot, scrollDistance, targetIndex) {
		const total = sections.length;
		const totalSegments = getDatasetValue(
			scrollRoot,
			'totalSegments',
			String((total - 1) * SECTION_SCROLL_UNITS)
		);
		const timelineUnits = getDatasetValue(
			scrollRoot,
			'timelineUnits',
			String(TIMELINE_SCROLL_UNITS)
		);
		const timelineIndex = sections.findIndex(s => s.id === 'desktop-timeline');
		const extraUnits = Math.max(0, timelineUnits - SECTION_SCROLL_UNITS);
		const step = (scrollDistance - window.innerHeight) / totalSegments;
		const segment = timelineIndex >= 0 && targetIndex > timelineIndex
			? targetIndex * SECTION_SCROLL_UNITS + extraUnits
			: targetIndex * SECTION_SCROLL_UNITS;

		window.scrollTo({
			top: step * segment,
			behavior: 'smooth',
		});
	}

	function setupNavigation(sections, scrollRoot, scrollDistance) {
		// Anchor link navigation
		document.addEventListener('click', (e) => {
			const anchor = e.target?.closest?.('a[href^="#"]');
			if (!anchor) return;

			e.preventDefault();
			const href = anchor.getAttribute('href') || '';
			const targetId = href.replace('#', '');
			const targetIndex = sections.findIndex(s => s.id === targetId);

			if (targetIndex !== -1) {
				scrollToSection(sections, scrollRoot, scrollDistance, targetIndex);
			}
		});

		// Custom event navigation
		window.addEventListener('gotosection', (e) => {
			const index = e.detail?.index;
			if (typeof index === 'number') {
				scrollToSection(sections, scrollRoot, scrollDistance, index);
			}
		});
	}

	// ============================================
	// SCROLL TRIGGER SETUP
	// ============================================
	function createScrollTrigger(sections, scrollRoot, scrollStage, scrollDistance) {
		const total = sections.length;
		let activeIndex = 0;

		ScrollTrigger.create({
			trigger: scrollRoot,
			start: 'top top',
			end: () => `+=${scrollDistance - window.innerHeight}`,
			scrub: 2,
			pin: scrollStage,
			anticipatePin: 1,
			snap: false,
			onUpdate: (self) => {
				const totalSegments = getDatasetValue(
					scrollRoot,
					'totalSegments',
					String((total - 1) * SECTION_SCROLL_UNITS)
				);

				const exactProgress = self.progress * totalSegments;
				const { mappedProgress, timelineProgress } = calculateProgress(
					exactProgress,
					sections,
					scrollRoot
				);

				const clampedMappedProgress = clamp(mappedProgress, 0, total - 1);
				const clampedTimelineProgress = clamp(timelineProgress, 0, 1);

				// Update background layers
				updateBackgroundLayers(clampedMappedProgress);

				// Update section visibility
				const targetIndex = calculateTargetSection(clampedMappedProgress, total);
				activeIndex = updateSectionVisibility(sections, targetIndex, activeIndex);

				// Dispatch timeline progress event
				const timelineIndex = sections.findIndex(s => s.id === 'desktop-timeline');
				if (timelineIndex >= 0) {
					window.dispatchEvent(new CustomEvent('timelineprogress', {
						detail: { progress: clampedTimelineProgress }
					}));
				}
			},
		});
	}

	// ============================================
	// DESKTOP SCROLL EXPERIENCE
	// ============================================
	function initDesktopScrollExperience(scrollRoot, scrollStage, sections) {
		console.log('[GSAP] Desktop detected - initializing GSAP scroll experience');

		const scrollDistance = calculateScrollHeight(sections, scrollRoot);
		initializeSectionPositions(sections);
		createScrollTrigger(sections, scrollRoot, scrollStage, scrollDistance);
		setupNavigation(sections, scrollRoot, scrollDistance);

		// Handle window resize
		window.addEventListener('resize', () => {
			calculateScrollHeight(sections, scrollRoot);
			ScrollTrigger.refresh();
		});
	}

	// ============================================
	// MOBILE SWIPER EXPERIENCE
	// ============================================
	
	// Store Swiper instance globally for cleanup
	let mobileSwiper = null;

	function initMobileSwiperExperience(sections, scrollRoot) {
		console.log('[Swiper] Mobile detected - initializing Swiper');

		// Set dynamic viewport height (accounts for mobile browser bar).
		// Uses visualViewport API as primary source (most accurate on mobile),
		// falls back to window.innerHeight. Sets --app-height CSS variable
		// which all mobile Swiper CSS references instead of 100dvh/100vh.
		function setViewportHeight() {
			const realHeight = window.visualViewport?.height || window.innerHeight;
			const vh = realHeight * 0.01;
			document.documentElement.style.setProperty('--vh', `${vh}px`);
			document.documentElement.style.setProperty('--app-height', `${realHeight}px`);
			console.log(`[Viewport] --app-height set to ${realHeight}px (visualViewport: ${window.visualViewport?.height}, innerHeight: ${window.innerHeight})`);
		}
		setViewportHeight();
		window.addEventListener('resize', setViewportHeight);
		window.addEventListener('orientationchange', setViewportHeight);
		// Use visualViewport API for better mobile browser bar detection
		if (window.visualViewport) {
			window.visualViewport.addEventListener('resize', setViewportHeight);
		}


		// Clean up any existing Swiper instance
		if (mobileSwiper) {
			mobileSwiper.destroy(true, true);
			mobileSwiper = null;
		}

		// Clear any GSAP styles on sections
		sections.forEach(section => {
			gsap.set(section, { clearProps: 'all' });
		});

		const scrollStage = document.querySelector('.scroll-stage');
		if (!scrollStage) return;

		// Add classes to html and body to prevent pull-to-refresh
		document.documentElement.classList.add('mobile-swiper-active-html');
		document.body.classList.add('mobile-swiper-active-body');

		// Set up the DOM structure for Swiper
		// Height is controlled via CSS var(--app-height) set by setViewportHeight()
		scrollRoot.classList.add('mobile-swiper-active');

		// Add swiper classes to existing structure
		scrollStage.classList.add('swiper');
		
		// Create wrapper div for slides - check for DIRECT child wrapper only
		const existingWrapper = scrollStage.querySelector(':scope > .swiper-wrapper');
		if (!existingWrapper) {
			const wrapper = document.createElement('div');
			wrapper.className = 'swiper-wrapper';
			wrapper.setAttribute('data-main-wrapper', 'true');
			
			// Move all scroll-panel sections into wrapper, EXCLUDING desktop-timeline on mobile
			const panels = scrollStage.querySelectorAll(':scope > .scroll-panel');
			panels.forEach(panel => {
				// Skip desktop-timeline on mobile - it should not be a Swiper slide
				if (panel.id === 'desktop-timeline') {
					panel.style.display = 'none';
					return;
				}
				panel.classList.add('swiper-slide');
				wrapper.appendChild(panel);
			});
			
			scrollStage.appendChild(wrapper);
		}
		

		// Mark slides with scrollable content (only timeline now - skills and projects use horizontal carousels)
		const slidesWithScroll = ['mobile-timeline'];
		slidesWithScroll.forEach(id => {
			const slide = document.getElementById(id);
			if (slide) {
				slide.dataset.hasScroll = 'true';
			}
		});

		// Configure Swiper based on scroll mode
		const swiperConfig = getSwiperConfig();
		
		// Initialize Swiper
		mobileSwiper = new Swiper('.scroll-stage.swiper', swiperConfig);

		// ===== Z-INDEX OVERRIDE for cover effect =====
		// CSS !important alone doesn't reliably override Swiper's inline z-index on all devices.
		// This JS handler runs after Swiper's creative effect on every frame and sets
		// index-based z-index (later slides always on top) using inline !important.
		mobileSwiper.on('setTranslate', function() {
			const slides = this.slides;
			if (!slides) return;
			for (let i = 0; i < slides.length; i++) {
				slides[i].style.setProperty('z-index', String(i + 1), 'important');
			}
		});

		// ===== FORCE slide children to match slide dimensions via JS =====
		// CSS approaches (height:100%, max-height:100%, position:absolute) all fail
		// because Swiper modifies the DOM (possibly adding transform wrappers)
		// and flex-in-flex percentage calculations are unreliable across browsers.
		// JS with setProperty('...', value, 'important') is the nuclear option that
		// nothing can override.
		// Slides that need internal scrolling - do NOT set overflow:hidden on these
		const scrollableSlides = new Set(['mobile-timeline']);

		// Force a single slide's children to match its height.
		// Prevents content overflow caused by Swiper's DOM manipulation.
		function forceOneSlideHeight(slide) {
			const slideRect = slide.getBoundingClientRect();
			const slideH = slideRect.height;
			const isScrollable = scrollableSlides.has(slide.id);

			// Scrollable slides (Timeline): leave completely untouched.
			// They need content taller than the slide for internal scroll + ScrollTrigger.
			if (isScrollable) {
					return;
			}

			// Walk ALL children (including Swiper-added wrappers)
			for (const child of slide.children) {
				const tag = child.tagName.toLowerCase();
				const cls = child.className?.toString() || '';

				// Skip script tags
				if (tag === 'script' || tag === 'style') continue;

				// Force the child to match slide height and clip overflow
				child.style.setProperty('height', `${slideH}px`, 'important');
				child.style.setProperty('max-height', `${slideH}px`, 'important');
				child.style.setProperty('min-height', '0', 'important');
				child.style.setProperty('overflow', 'hidden', 'important');
				child.style.setProperty('box-sizing', 'border-box', 'important');

				// If this is a Swiper transform wrapper, also force its children
				if (cls.includes('swiper-slide-transform')) {
					for (const grandchild of child.children) {
						if (grandchild.tagName.toLowerCase() === 'script') continue;
						grandchild.style.setProperty('height', `${slideH}px`, 'important');
						grandchild.style.setProperty('max-height', `${slideH}px`, 'important');
						grandchild.style.setProperty('min-height', '0', 'important');
						grandchild.style.setProperty('overflow', 'hidden', 'important');
						grandchild.style.setProperty('box-sizing', 'border-box', 'important');
					}
				}
			}
		}

		// Full pass: force height on ALL slides (used for init and resize)
		function forceAllSlidesHeight() {
			const allSlides = document.querySelectorAll('.mobile-swiper-active .scroll-stage.swiper > .swiper-wrapper > .swiper-slide');
			allSlides.forEach(slide => forceOneSlideHeight(slide));
		}

		// Run after Swiper init (give it time to set up DOM)
		setTimeout(forceAllSlidesHeight, 200);
		// Run again after a longer delay (Swiper creative effect may modify DOM later)
		setTimeout(forceAllSlidesHeight, 600);
		// Also run when viewport height changes
		window.addEventListener('resize', () => setTimeout(forceAllSlidesHeight, 100));
		if (window.visualViewport) {
			window.visualViewport.addEventListener('resize', () => setTimeout(forceAllSlidesHeight, 100));
		}

		// Re-force height on active slide AFTER transition completes (avoids layout thrashing mid-animation)
		if (mobileSwiper) {
			mobileSwiper.on('slideChangeTransitionEnd', function() {
				const activeSlide = this.slides[this.activeIndex];
				if (activeSlide) {
					setTimeout(() => forceOneSlideHeight(activeSlide), 50);
				}
			});
		}

		// Force overflow-y on scrollable slides via JavaScript (only timeline now)
		const scrollableSlideIds = ['mobile-timeline'];
		scrollableSlideIds.forEach(id => {
			const slide = document.getElementById(id);
			if (slide) {
				slide.style.overflowY = 'auto';
				slide.style.webkitOverflowScrolling = 'touch';
				slide.style.overscrollBehavior = 'contain';
				slide.dataset.hasScroll = 'true';
			}
		});

		// Initialize nested horizontal Swipers for Skills and Projects
		// Wait for next frame to ensure main Swiper is fully initialized
		requestAnimationFrame(() => {
			try {
				initNestedHorizontalSwipers();
			} catch (e) {
				console.error('[Swiper] Failed to init nested swipers:', e);
			}
		});

		// Set background image CSS variable for Hero and About slides
		const bgImageLayer = scrollStage.querySelector('.background-image-layer');
		if (bgImageLayer) {
			const bgImage = bgImageLayer.style.backgroundImage || getComputedStyle(bgImageLayer).backgroundImage;
			document.documentElement.style.setProperty('--mobile-bg-image', bgImage);
		}

		// Hide the separate background layers on mobile (we're using slide backgrounds instead)
		const bgLayers = scrollStage.querySelectorAll('.base-background, .background-image-layer, .overlay-full, .overlay-gradient');
		bgLayers.forEach(layer => {
			layer.style.display = 'none';
		});


		// Set up background fade handler
		initMobileSwiperBackgroundFade(mobileSwiper);

		// Set up navigation integration
		initMobileSwiperNavigation(mobileSwiper, sections);

		// Set up nested scroll handling for slides with overflow
		initNestedScrollHandling(mobileSwiper, sections);
		
		// Set up custom pull-to-refresh for home page
		initPullToRefresh(mobileSwiper);

		console.log('[Swiper] Mobile Swiper initialized successfully');
	}

	function getSwiperConfig() {
		return {
			modules: [EffectCreative, Mousewheel, HashNavigation],
			direction: 'vertical',
			slidesPerView: 1,
			speed: 350,
			effect: 'creative',
			creativeEffect: {
				// "Cover" effect: next slides up over current, prev fades out in place.
				// prev.opacity: 0 means the leaving slide fades to transparent, revealing
				// the incoming slide through it — creating the cover illusion.
				prev: {
					translate: [0, 0, 0],   // Stay in place — covered by the incoming slide
					opacity: 0,             // Fade out so incoming slide shows through
					scale: 1,
				},
				next: {
					translate: [0, '100%', 0],  // Start below viewport, slide up to cover
					opacity: 1,
					shadow: false,
				},
				limitProgress: 2,
			},
			hashNavigation: {
				watchState: true,
			},
			grabCursor: false,
			preventInteractionOnTransition: true,
			resistance: true,
			resistanceRatio: 0.65,
			watchSlidesProgress: true,
			observer: true,
			observeParents: true,
			// Improve touch handling
			touchStartPreventDefault: false,
			touchMoveStopPropagation: false,
			passiveListeners: true,
			// Prevent unwanted behaviors
			simulateTouch: true,
			allowTouchMove: true,
			followFinger: true,
			// Swipe settings (edge-release behavior)
			mousewheel: {
				enabled: false,
			},
			touchReleaseOnEdges: false,  // Prevent browser taking over at edges (triggers pull-to-refresh)
			threshold: 15,
			touchAngle: 45,
			longSwipesRatio: 0.4,
			longSwipesMs: 250,
			on: {
				slideChange: function() {
					const index = this.activeIndex;
					const swiper = this;
					console.log(`[Swiper] Slide changed to: ${index}`);
					
					// Debounce side-effects (navbar, nested swipers, pull-to-refresh)
					// to prevent DOM thrashing during finger oscillation at section boundaries.
					// Without this, rapid slideChange events cause layout recalculations
					// mid-animation-frame which appear as visual flicker.
					clearTimeout(swiper._slideChangeDebounce);
					swiper._slideChangeDebounce = setTimeout(() => {
						// Only process if user is still on this slide
						if (swiper.activeIndex !== index) return;
						
						// Dispatch section change event for navbar
						window.dispatchEvent(new CustomEvent('sectionchange', {
							detail: { index }
						}));

						// Reset scroll position of slides with scrollable content
						const currentSlide = swiper.slides[index];
						if (currentSlide && currentSlide.dataset.hasScroll === 'true') {
							currentSlide.scrollTop = 0;
						}

						// Update nested Swipers when slide becomes visible
						updateNestedSwipersOnSlide(currentSlide);
						
						// Update pull-to-refresh behavior based on slide
						updatePullToRefreshForSlide(index);
					}, 100);
				},
				init: function() {
					// Dispatch initial section
					window.dispatchEvent(new CustomEvent('sectionchange', {
						detail: { index: 0 }
					}));
					// Enable pull-to-refresh on home (slide 0)
					updatePullToRefreshForSlide(0);
				},
				touchStart: function(swiper, event) {
					// Store touch start position for nested scroll detection
					swiper.touchStartY = event.touches ? event.touches[0].clientY : event.clientY;
				},
				touchEnd: function(swiper, event) {
					// Touch end handler
				}
			}
		};
	}
	
	// Custom pull-to-refresh for home page
	// Native pull-to-refresh doesn't work with position:fixed, so we implement our own
	let pullToRefreshEnabled = false;
	let pullStartY = 0;
	let pullDistance = 0;
	const PULL_THRESHOLD = 120; // Distance to trigger reload
	let pullIndicator = null;
	
	function createPullIndicator() {
		if (pullIndicator) return pullIndicator;
		
		pullIndicator = document.createElement('div');
		pullIndicator.className = 'pull-to-refresh-indicator';
		pullIndicator.innerHTML = `
			<div class="pull-arrow">↓</div>
			<div class="pull-text">Pull to refresh</div>
		`;
		document.body.appendChild(pullIndicator);
		return pullIndicator;
	}
	
	function updatePullIndicator(distance) {
		if (!pullIndicator) return;
		
		const progress = Math.min(distance / PULL_THRESHOLD, 1);
		pullIndicator.style.opacity = progress;
		pullIndicator.style.transform = `translateX(-50%) translateY(${Math.min(distance * 0.5, 60)}px)`;
		
		if (progress >= 1) {
			pullIndicator.querySelector('.pull-text').textContent = 'Release to refresh';
			pullIndicator.querySelector('.pull-arrow').style.transform = 'rotate(180deg)';
		} else {
			pullIndicator.querySelector('.pull-text').textContent = 'Pull to refresh';
			pullIndicator.querySelector('.pull-arrow').style.transform = 'rotate(0deg)';
		}
	}
	
	function hidePullIndicator() {
		if (!pullIndicator) return;
		pullIndicator.style.opacity = '0';
		pullIndicator.style.transform = 'translateX(-50%) translateY(0)';
	}
	
	function updatePullToRefreshForSlide(index) {
		pullToRefreshEnabled = (index === 0);
		
		if (pullToRefreshEnabled) {
			createPullIndicator();
		} else {
			hidePullIndicator();
		}
	}
	
	// Set up pull-to-refresh touch handlers on the home slide
	function initPullToRefresh(swiper) {
		const homeSlide = document.getElementById('home');
		if (!homeSlide) return;
		
		homeSlide.addEventListener('touchstart', (e) => {
			if (!pullToRefreshEnabled) return;
			if (swiper.activeIndex !== 0) return;
			
			pullStartY = e.touches[0].clientY;
			pullDistance = 0;
		}, { passive: true });
		
		homeSlide.addEventListener('touchmove', (e) => {
			if (!pullToRefreshEnabled) return;
			if (swiper.activeIndex !== 0) return;
			
			const currentY = e.touches[0].clientY;
			pullDistance = currentY - pullStartY;
			
			// Only activate for downward pull (positive distance)
			if (pullDistance > 0) {
				updatePullIndicator(pullDistance);
				
				// Prevent native pull-to-refresh AND Swiper from taking over
				if (pullDistance > 20) {
					e.preventDefault();
					swiper.allowTouchMove = false;
				}
			}
		}, { passive: false });
		
		homeSlide.addEventListener('touchend', () => {
			if (!pullToRefreshEnabled) return;
			
			if (pullDistance >= PULL_THRESHOLD) {
				// Trigger reload
				hidePullIndicator();
				window.location.reload();
			} else {
				hidePullIndicator();
			}
			
			pullDistance = 0;
			// Re-enable swiper
			swiper.allowTouchMove = true;
		}, { passive: true });
	}

	function initMobileSwiperBackgroundFade(swiper) {
		const backgroundImageLayer = document.querySelector('.background-image-layer');
		const overlayFull = document.querySelector('.overlay-full');
		const overlayGradient = document.querySelector('.overlay-gradient');

		if (!backgroundImageLayer) return;

		function updateBackgroundForSlide(index, progress = 0) {
			// Sections 0-1 (Hero, About): Show background
			// Section 2+ (Skills onward): Hide background
			
			if (index === 0) {
				// Hero: Full overlay visible
				setElementVisibility(backgroundImageLayer, 1);
				setElementVisibility(overlayFull, 1);
				setElementVisibility(overlayGradient, 0);
			} else if (index === 1) {
				// About: Gradient overlay, start fading based on progress
				setElementVisibility(backgroundImageLayer, 1);
				setElementVisibility(overlayFull, 0);
				setElementVisibility(overlayGradient, 1);
			} else {
				// Skills and beyond: Hide background
				setElementVisibility(backgroundImageLayer, 0);
				setElementVisibility(overlayFull, 0);
				setElementVisibility(overlayGradient, 0);
			}
		}

		// Handle slide transitions with smooth fade
		swiper.on('slideChange', function() {
			updateBackgroundForSlide(this.activeIndex);
		});

		// Handle progress during transition for smooth fade
		swiper.on('progress', function(progress) {
			const activeIndex = this.activeIndex;
			
			// When transitioning from About (1) to Skills (2), fade out background
			if (activeIndex === 1 && this.progress > 0) {
				const slideProgress = (this.progress - (1 / (this.slides.length - 1))) * (this.slides.length - 1);
				if (slideProgress > 0 && slideProgress < 1) {
					const fadeProgress = slideProgress;
					setElementVisibility(backgroundImageLayer, 1 - fadeProgress);
					setElementVisibility(overlayGradient, 1 - fadeProgress);
				}
			}
		});

		// Initial state
		updateBackgroundForSlide(0);
	}

	function initMobileSwiperNavigation(swiper, sections) {
		// Handle nav link clicks
		document.querySelectorAll('a[href^="#"]').forEach(link => {
			link.addEventListener('click', (e) => {
				if (!isMobile() || !mobileSwiper) return;
				
				e.preventDefault();
				const href = link.getAttribute('href') || '';
				const targetId = href.replace('#', '');
				
				// Find section index
				const sectionIds = ['home', 'about', 'skills', 'projects', 'mobile-timeline', 'contact'];
				let targetIndex = sectionIds.indexOf(targetId);
				
				// Handle timeline alias
				if (targetId === 'timeline') {
					targetIndex = sectionIds.indexOf('mobile-timeline');
				}
				
				if (targetIndex !== -1) {
					swiper.slideTo(targetIndex);
					
					// Close mobile menu if open (Alpine.js)
					const mobileMenuContainer = document.getElementById('mobile-menu-container');
					if (mobileMenuContainer && mobileMenuContainer.__x) {
						mobileMenuContainer.__x.$data.open = false;
					}
				}
			});
		});

		// Handle gotosection custom event
		window.addEventListener('gotosection', (e) => {
			if (!isMobile() || !mobileSwiper) return;
			
			const index = e.detail?.index;
			if (typeof index === 'number') {
				swiper.slideTo(index);
			}
		});
	}

	// Store nested Swiper instances for cleanup
	let nestedSwipers = [];

	// Update nested Swipers when a slide becomes visible
	function updateNestedSwipersOnSlide(slide) {
		if (!slide) return;
		
		// Find any Swiper instances inside this slide and update them
		const nestedContainers = slide.querySelectorAll('.swiper');
		nestedContainers.forEach(container => {
			if (container.swiper) {
				container.swiper.update();
			}
		});
	}

	function initNestedHorizontalSwipers() {
		try {
			// Clean up any existing nested Swipers
			nestedSwipers.forEach(swiper => {
				if (swiper && swiper.destroy) {
					swiper.destroy(true, true);
				}
			});
			nestedSwipers = [];

			// Initialize Skills carousel
			const skillsCarousel = document.querySelector('[data-skills-carousel]');
			if (skillsCarousel) {
				// Pagination is now a sibling of the carousel, in .skills-panels-mobile
				const skillsWrapper = skillsCarousel.closest('.skills-panels-mobile');
				const skillsPaginationEl = skillsWrapper?.querySelector('.skills-pagination');
				
				
				const skillsSwiper = new Swiper(skillsCarousel, {
					modules: [Pagination],
					direction: 'horizontal',
					slidesPerView: 1,
					spaceBetween: 20,
					speed: 300,
					grabCursor: true,
					// Use explicit pagination element reference with custom rendering
					pagination: skillsPaginationEl ? {
						el: skillsPaginationEl,
						clickable: true,
						bulletClass: 'swiper-pagination-bullet',
						bulletActiveClass: 'swiper-pagination-bullet-active',
						renderBullet: function (index, className) {
							return '<span class="' + className + '" style="background-color: #ff8c3c !important;"></span>';
						},
					} : false,
					// Allow vertical swipe to pass through to parent
					touchReleaseOnEdges: true,
					threshold: 5,
					touchAngle: 30,
					nested: true,
					// Observe for visibility changes
					observer: true,
					observeParents: true,
					observeSlideChildren: true,
					on: {
						init: function() {
							// Force update after a short delay to ensure dimensions are correct
							setTimeout(() => this.update(), 100);
						}
					}
				});
				// Store reference on element for updates
				skillsCarousel.swiper = skillsSwiper;
				nestedSwipers.push(skillsSwiper);
			} else {
				console.warn('[Swiper] Skills carousel element not found');
			}

			// Initialize Projects carousels (one for each category tab)
			const projectsCarousels = document.querySelectorAll('[data-projects-carousel]');
			projectsCarousels.forEach(carousel => {
				const categoryId = carousel.getAttribute('data-projects-carousel');
				// Pagination is now a sibling of the carousel, in .project-panel-mobile
				const panelMobile = carousel.closest('.project-panel-mobile');
				const paginationEl = panelMobile?.querySelector(`[data-projects-pagination="${categoryId}"]`);
				
				const projectsSwiper = new Swiper(carousel, {
					modules: [Pagination],
					direction: 'horizontal',
					slidesPerView: 1,
					spaceBetween: 20,
					speed: 300,
					grabCursor: true,
					// Use custom rendering for orange bullets
					pagination: paginationEl ? {
						el: paginationEl,
						clickable: true,
						bulletClass: 'swiper-pagination-bullet',
						bulletActiveClass: 'swiper-pagination-bullet-active',
						renderBullet: function (index, className) {
							return '<span class="' + className + '" style="background-color: #ff8c3c !important;"></span>';
						},
					} : false,
					// Allow vertical swipe to pass through to parent
					touchReleaseOnEdges: true,
					threshold: 5,
					touchAngle: 30,
					nested: true,
					// Observe for visibility changes
					observer: true,
					observeParents: true,
					observeSlideChildren: true,
				});
				
				// Store reference on the element for tab switching updates
				carousel.swiper = projectsSwiper;
				nestedSwipers.push(projectsSwiper);
			});

		} catch (error) {
			console.error('[Swiper] Error initializing nested carousels:', error);
		}
	}

	function initNestedScrollHandling(swiper, sections) {
		// For slides with scrollable content (only mobile-timeline now that all pages are full-screen)
		// Edge-release behavior: scroll content freely, release to swiper at edges
		const slidesWithScroll = ['mobile-timeline'];
		
		slidesWithScroll.forEach(slideId => {
			const slide = document.getElementById(slideId);
			if (!slide) return;

			const scrollContainer = slide;
			let touchStartY = 0;
			

			function getScrollState() {
				const { scrollTop, scrollHeight, clientHeight } = scrollContainer;
				const isAtTop = scrollTop <= 2;
				const isAtBottom = scrollTop + clientHeight >= scrollHeight - 2;
				const hasScrollableContent = scrollHeight > clientHeight + 10;
				return { isAtTop, isAtBottom, hasScrollableContent };
			}

			slide.addEventListener('touchstart', (e) => {
				touchStartY = e.touches[0].clientY;
				const state = getScrollState();
				
				// If no scrollable content, always allow swiper
				if (!state.hasScrollableContent) {
					swiper.allowTouchMove = true;
					return;
				}
				
				// Start with swiper disabled for scrollable slides
				swiper.allowTouchMove = false;
			}, { passive: true });

			slide.addEventListener('touchmove', (e) => {
				const touchY = e.touches[0].clientY;
				const deltaY = touchStartY - touchY; // positive = scrolling down
				
				const { isAtTop, isAtBottom, hasScrollableContent } = getScrollState();
				
				if (!hasScrollableContent) {
					swiper.allowTouchMove = true;
					return;
				}
				
				// At top and trying to go to previous slide (swipe down / deltaY < 0)
				if (isAtTop && deltaY < -10) {
					swiper.allowTouchMove = true;
				}
				// At bottom and trying to go to next slide (swipe up / deltaY > 0)
				else if (isAtBottom && deltaY > 10) {
					swiper.allowTouchMove = true;
				}
				else {
					swiper.allowTouchMove = false;
				}
			}, { passive: true });

			slide.addEventListener('touchend', () => {
				setTimeout(() => {
					swiper.allowTouchMove = true;
				}, 100);
			}, { passive: true });
		});
	}

	// Legacy function for non-Swiper mobile (kept for reference but not used)
	function resetMobileStyles(sections, scrollRoot) {
		console.log('[GSAP] Mobile detected - legacy CSS mode (deprecated)');
		sections.forEach(section => {
			gsap.set(section, { clearProps: 'all' });
		});
		scrollRoot.style.height = 'auto';
	}

	function initMobileBackgroundFade() {
		// This is now handled by initMobileSwiperBackgroundFade
		// Kept for compatibility but does nothing when Swiper is active
		if (!isMobile() || mobileSwiper) return;
	}

	// ============================================
	// TIMELINE VISIBILITY
	// ============================================
	function handleTimelineVisibility() {
		const desktop = document.querySelector('#desktop-timeline');
		const mobile = document.querySelector('#mobile-timeline');

		if (!desktop || !mobile) {
			console.warn('[Timeline] Could not find timeline elements');
			return;
		}

		const mobileMode = isMobile();

		if (mobileMode) {
			desktop.style.setProperty('display', 'none', 'important');
			mobile.style.setProperty('display', 'flex', 'important');
		} else {
			mobile.style.setProperty('display', 'none', 'important');
			desktop.style.setProperty('display', 'flex', 'important');
		}
	}

	// ============================================
	// VIEWPORT HEIGHT HANDLING
	// ============================================
	function initViewportHeight() {
		// Set --vh and --app-height CSS variables for consistent viewport height on mobile.
		// Uses visualViewport API when available for best accuracy.
		function setVH() {
			const realHeight = window.visualViewport?.height || window.innerHeight;
			const vh = realHeight * 0.01;
			document.documentElement.style.setProperty('--vh', `${vh}px`);
			document.documentElement.style.setProperty('--app-height', `${realHeight}px`);
		}

		setVH();
		
		// Update on resize and orientation change
		window.addEventListener('resize', setVH);
		window.addEventListener('orientationchange', () => {
			// Delay to allow browser to settle
			setTimeout(setVH, 100);
		});
		// visualViewport resize fires when browser chrome (address bar) changes
		if (window.visualViewport) {
			window.visualViewport.addEventListener('resize', setVH);
		}
	}

	// ============================================
	// MAIN INITIALIZATION
	// ============================================
	function initScrollExperience() {
		const scrollRoot = document.querySelector('#scroll-root');
		const scrollStage = document.querySelector('.scroll-stage');
		const sections = Array.from(document.querySelectorAll('.scroll-panel'))
			.filter(section => {
				// Filter out the timeline that's not visible for the current viewport
				if (isMobile()) {
					// On mobile, exclude desktop timeline
					return section.id !== 'desktop-timeline';
				} else {
					// On desktop, exclude mobile timeline
					return section.id !== 'mobile-timeline';
				}
			});

		if (!scrollRoot || !scrollStage || !sections.length) {
			return;
		}

		if (isMobile()) {
