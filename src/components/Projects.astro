---
import ProjectCard from './ProjectCard.astro';
import SectionTitle from './SectionTitle.astro';

interface Project {
	title: string;
	description: string;
	technologies: string[];
	projectUrl?: string;
	codeUrl?: string;
	category?: string;
}

interface ProjectCategory {
	id: string;
	label: string;
	projects: Project[];
}

interface Props {
	categories?: ProjectCategory[];
	projects?: Project[]; // Flat array from markdown files with category field
}

const { categories: propCategories, projects: propProjects } = Astro.props;

// Determine which format we received and normalize to categories
let categories: ProjectCategory[];

if (propCategories && propCategories.length > 0) {
	// Already in categories format (legacy support)
	categories = propCategories;
} else if (propProjects && Array.isArray(propProjects) && propProjects.length > 0) {
	// Flat array from markdown files - group by category
	const projectsByCategory = new Map<string, Project[]>();

	propProjects.forEach((project) => {
		const categoryId = project.category || 'uncategorized';
		if (!projectsByCategory.has(categoryId)) {
			projectsByCategory.set(categoryId, []);
		}
		projectsByCategory.get(categoryId)!.push(project);
	});

	// Convert map to categories array with proper labels
	categories = Array.from(projectsByCategory.entries()).map(([id, projects]) => ({
		id,
		label: id.charAt(0).toUpperCase() + id.slice(1), // Capitalize category name
		projects,
	}));

	// Sort categories in specific order: Work, Ventures, Playground
	const categoryOrder = ['work', 'ventures', 'playground'];
	categories.sort((a, b) => {
		const aIndex = categoryOrder.indexOf(a.id);
		const bIndex = categoryOrder.indexOf(b.id);

		// If category not in order array, put it at the end
		if (aIndex === -1) return 1;
		if (bIndex === -1) return -1;

		return aIndex - bIndex;
	});
} else {
	// Fallback to default categories
	categories = [
		{
			id: "work",
			label: "Work",
			projects: [
				{
					title: "E-Commerce Store",
					description: "A high-converting Shopify store with custom theme development, optimized checkout flow, and seamless integrations.",
					technologies: ["Shopify", "Liquid", "JavaScript"],
					projectUrl: "#",
					codeUrl: "#",
				},
				{
					title: "Brand Website",
					description: "Custom Shopify storefront with unique design system, advanced filtering, and performance optimization.",
					technologies: ["Shopify", "Tailwind", "Alpine.js"],
					projectUrl: "#",
					codeUrl: "#",
				},
				{
					title: "Multi-region Store",
					description: "International e-commerce platform with multi-currency support, localization, and custom apps.",
					technologies: ["Shopify Plus", "React", "Node.js"],
					projectUrl: "#",
					codeUrl: "#",
				},
			],
		},
		{
			id: "ventures",
			label: "Ventures",
			projects: [
				{
					title: "SaaS Platform",
					description: "A collaborative project building a modern SaaS application with subscription management and analytics dashboard.",
					technologies: ["Next.js", "PostgreSQL", "Stripe"],
					projectUrl: "#",
					codeUrl: "#",
				},
				{
					title: "Mobile App",
					description: "Cross-platform mobile application developed independently, featuring real-time sync and offline support.",
					technologies: ["React Native", "Firebase", "TypeScript"],
					projectUrl: "#",
					codeUrl: "#",
				},
			],
		},
		{
			id: "playground",
			label: "Playground",
			projects: [
				{
					title: "Creative Experiment",
					description: "An interactive art piece exploring generative design and creative coding techniques.",
					technologies: ["Three.js", "GLSL", "Canvas"],
					projectUrl: "#",
					codeUrl: "#",
				},
				{
					title: "Open Source Tool",
					description: "A developer utility built for fun that ended up helping the community. Contributions welcome!",
					technologies: ["Rust", "CLI", "GitHub Actions"],
					projectUrl: "#",
					codeUrl: "#",
				},
				{
					title: "Game Prototype",
					description: "A weekend game jam project exploring procedural generation and pixel art aesthetics.",
					technologies: ["Godot", "GDScript", "Aseprite"],
					projectUrl: "#",
					codeUrl: "#",
				},
			],
		},
	];
}
---

<section id="projects" class="container lg:pb-16! projects min-h-screen max-h-screen w-full flex max-lg:pb-0!">
	<div class="w-full flex flex-col items-center min-h-0 flex-1">
		<div class="shrink-0 pt-4">
			<SectionTitle number="03" title="Featured Projects" />
		</div>
		
		<!-- Desktop: Tab layout -->
		<div class="hidden lg:flex flex-col items-center lg:justify-center flex-1 min-h-0 w-full">
      <!-- Desktop Tabs -->
      <div class="project-tabs shrink-0" role="tablist">
        {categories.map((category, index) => (
          <button
            class={`project-tab ${index === 0 ? 'active' : ''}`}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`panel-${category.id}`}
            data-tab={category.id}
          >
            {category.label}
          </button>
        ))}
      </div>

      <!-- Desktop: Tab Panels with grid -->
      <div class="project-panels no-scrollbar">
        {categories.map((category, index) => (
          <div
            id={`panel-${category.id}`}
            class={`project-panel ${index === 0 ? 'active' : ''}`}
            role="tabpanel"
            aria-hidden={index === 0 ? 'false' : 'true'}
            data-panel={category.id}
          >
            <div class="projects-grid">
              {category.projects.map((project) => (
                <ProjectCard {...project} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile: Vertical stack with carousel, dots, and tabs -->
    <div class="project-panels-mobile lg:hidden">
      {categories.map((category, index) => (
        <div
          id={`panel-mobile-${category.id}`}
          class={`project-panel-mobile ${index === 0 ? 'active' : ''}`}
          role="tabpanel"
          aria-hidden={index === 0 ? 'false' : 'true'}
          data-panel-mobile={category.id}
        >
          <div class="projects-carousel swiper" data-projects-carousel={category.id}>
            <div class="swiper-wrapper projects-carousel-wrapper">
              {category.projects.map((project) => (
                <div class="swiper-slide projects-carousel-slide">
                  <ProjectCard {...project} />
                </div>
              ))}
            </div>
          </div>
          <!-- Pagination dots outside swiper -->
          <div class="projects-pagination" data-projects-pagination={category.id}></div>
        </div>
      ))}
      <!-- Mobile Tabs at bottom -->
      <div class="project-tabs-mobile" role="tablist">
        {categories.map((category, index) => (
          <button
            class={`project-tab ${index === 0 ? 'active' : ''}`}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`panel-mobile-${category.id}`}
            data-tab={category.id}
          >
            {category.label}
          </button>
        ))}
      </div>
    </div>
	</div>
</section>

<style>
  /* Desktop: Tab Panels */
  .project-panels {
    width: 100%;
    position: relative;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .project-panels::-webkit-scrollbar {
    display: none;
  }

  /* Mobile-only styles - wrapped in media query */
  @media (max-width: 1023px) {
    /* Mobile: Main container with flex layout */
    .project-panels-mobile {
      width: 100%;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      padding: 0.5rem 0;
    }

    .project-panel-mobile {
      display: none;
      flex: 1;
      min-height: 0;
      flex-direction: column;
    }

    .project-panel-mobile.active {
      display: flex;
      animation: fadeIn 0.4s ease;
    }

    /* Mobile: Horizontal carousel fills available space */
    .projects-carousel {
      width: 100%;
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    /* Swiper wrapper - horizontal flex row */
    .projects-carousel .swiper-wrapper {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: stretch;
      height: 100%;
    }

    .projects-carousel .swiper-slide {
      display: flex;
      align-items: stretch;
      justify-content: center;
      padding: 0 1rem;
      box-sizing: border-box;
      width: 100% !important;
      min-width: 100% !important;
      height: 100% !important;
      flex-shrink: 0 !important;
    }

    /* Project card fills the entire slide */
    .projects-carousel .swiper-slide :global(.project-card) {
      width: 100%;
      height: 100%;
      max-width: none;
      display: flex;
      flex-direction: column;
    }

    /* Pagination dots - static flow, not absolute */
    .projects-pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 0.75rem 0;
      flex-shrink: 0;
    }
  }

  /* Mobile pagination bullets - only on mobile */
  @media (max-width: 1023px) {
    .projects-pagination .swiper-pagination-bullet {
      width: 8px;
      height: 8px;
      background: #ff8c3c !important;
      opacity: 0.4 !important;
      border-radius: 50%;
      transition: all 0.3s ease;
    }

    html.dark .projects-pagination .swiper-pagination-bullet {
      background: #ff8c3c !important;
      opacity: 0.5 !important;
    }

    .projects-pagination .swiper-pagination-bullet-active {
      background: #ff8c3c !important;
      opacity: 1 !important;
      transform: scale(1.3);
    }

    /* Mobile tabs at bottom */
    .project-tabs-mobile {
      display: flex;
      justify-content: center;
      gap: 0.25rem;
      padding: 0.25rem;
      background: rgba(255, 255, 255, 0.25);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 100px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      flex-shrink: 0;
      margin: 0 auto;
    }

    html.dark .project-tabs-mobile {
      background: rgba(30, 41, 59, 0.4);
      border-color: rgba(148, 163, 184, 0.2);
    }

    .project-tabs-mobile .project-tab {
      padding: 0.625rem 1rem;
      font-size: 0.85rem;
    }
  }

  /* Desktop tabs */
  .project-tabs {
    display: flex;
    gap: 0.5rem;
    padding: 0.375rem;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    margin-bottom: 1rem;
  }

  html.dark .project-tabs {
    background: rgba(30, 41, 59, 0.4);
    border-color: rgba(148, 163, 184, 0.2);
  }

  .project-tab {
    padding: 0.75rem 1.5rem;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    cursor: pointer;
    border-radius: 100px;
    transition: all 0.3s ease;
    position: relative;
  }

  .project-tab:hover {
    color: var(--text-primary);
  }

  .project-tab.active {
    background: rgba(255, 255, 255, 0.6);
    color: var(--text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  html.dark .project-tab.active {
    background: rgba(30, 41, 59, 0.8);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .project-panel {
    display: none;
    animation: fadeIn 0.4s ease;
  }

  .project-panel.active {
    display: block;
  }

  /* Desktop: fadeIn with translateY for visual polish */
  @media (min-width: 1025px) {
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  /* Mobile: opacity-only fadeIn to avoid conflicting with Swiper's transform positioning */
  @media (max-width: 1024px) {
    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Desktop (>1024px) */
  @media (min-width: 1025px) {
    .projects-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }
</style>

<script>
	function initProjectTabs() {
		// Get all tabs (both desktop and mobile)
		const allTabs = document.querySelectorAll('.project-tab');
		const desktopPanels = document.querySelectorAll('.project-panel');
		const mobilePanels = document.querySelectorAll('.project-panel-mobile');

		allTabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const targetId = tab.getAttribute('data-tab');

				// Update ALL tabs (both desktop and mobile stay in sync)
				allTabs.forEach((t) => {
					t.classList.remove('active');
					t.setAttribute('aria-selected', 'false');
				});
				// Activate all tabs with the same data-tab value
				allTabs.forEach((t) => {
					if (t.getAttribute('data-tab') === targetId) {
						t.classList.add('active');
						t.setAttribute('aria-selected', 'true');
					}
				});

				// Update desktop panels
				desktopPanels.forEach((panel) => {
					const panelId = panel.getAttribute('data-panel');
					if (panelId === targetId) {
						panel.classList.add('active');
						panel.setAttribute('aria-hidden', 'false');
					} else {
						panel.classList.remove('active');
						panel.setAttribute('aria-hidden', 'true');
					}
				});

				// Update mobile panels
				mobilePanels.forEach((panel) => {
					const panelId = panel.getAttribute('data-panel-mobile');
					if (panelId === targetId) {
						panel.classList.add('active');
						panel.setAttribute('aria-hidden', 'false');
						// Trigger Swiper update when panel becomes visible.
						// Two updates: first quick one for initial layout, second after fadeIn
						// animation completes (400ms) to get accurate dimensions.
						const carousel = panel.querySelector('[data-projects-carousel]') as HTMLElement & { swiper?: { update: () => void } };
						if (carousel?.swiper) {
							setTimeout(() => carousel.swiper?.update(), 100);
							setTimeout(() => carousel.swiper?.update(), 450);
						}
					} else {
						panel.classList.remove('active');
						panel.setAttribute('aria-hidden', 'true');
					}
				});
			});
		});
	}

	// Initialize on load
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProjectTabs);
	} else {
		initProjectTabs();
	}
</script>